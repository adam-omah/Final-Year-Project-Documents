        <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Store UUID in Queue" enabled="true">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script">// Get the variable extracted by JSON Extractor
String uuid = vars.get(&quot;extracted_uuid&quot;)

// Get the shared queue from properties
def queue = props.get(&quot;uuidQueue&quot;)

// Add to queue only if extraction was successful and queue exists
if (uuid != null &amp;&amp; !uuid.equals(&quot;UUID_NOT_FOUND&quot;) &amp;&amp; queue != null) {
    queue.offer(uuid) // offer() is a standard method for queues
    //log.info(&quot;Added UUID to queue: &quot; + uuid) // Uncomment for debugging, can be very noisy
} else {
    log.warn(&quot;Failed to add UUID to queue. Extracted value: &quot; + uuid)
}</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
        </JSR223PostProcessor>
