        <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Get UUID from Que" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">// Get the shared queue
def queue = props.get(&quot;uuidQueue&quot;)

String uuidToUse = null
if (queue != null) {
    // Retrieve and remove a UUID from the head of the queue.
    // poll() is thread-safe and returns null if the queue is empty.
    uuidToUse = queue.poll()
}

if (uuidToUse != null) {
    // Store the retrieved UUID in a variable accessible to the sampler
    vars.put(&quot;uuid_for_modification&quot;, uuidToUse)
    //log.info(&quot;Retrieved UUID for modification: &quot; + uuidToUse) // Debugging
} else {
    log.warn(&quot;UUID queue is empty. Cannot perform modification.&quot;)
    // Set a default/indicator value if needed, the request will likely fail anyway
    vars.put(&quot;uuid_for_modification&quot;, &quot;NO_UUID_AVAILABLE&quot;)
}</stringProp>
        </JSR223PreProcessor>
