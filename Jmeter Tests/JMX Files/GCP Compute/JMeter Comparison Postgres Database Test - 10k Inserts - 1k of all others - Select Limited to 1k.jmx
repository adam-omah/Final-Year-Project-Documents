        <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Store UUID in que" enabled="true">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script">// Get the UUID we generated BEFORE the request
String uuidToStore = vars.get(&quot;pre_generated_uuid&quot;)

def queue = props.get(&quot;uuidQueue&quot;)

queue.offer(uuidToStore)</stringProp>
