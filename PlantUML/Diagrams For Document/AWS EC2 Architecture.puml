@startuml Layered EC2 VM Deployment (Combined Container - Basic PlantUML)

title AWS EC2 VM Deployment Layers (Combined Container - Basic)

skinparam packageStyle rectangle
skinparam node {
    borderColor Black
    borderThickness 1
}
skinparam component {
    borderColor Black
    borderThickness 1
}


actor "User / Client" as User

package "AWS Cloud" {

  package "Networking (VPC)" {
    node "AWS VPC" as VPC {
        node "Public Subnet" as Subnet
        node "Internet Gateway" as IGW
        node "Security Group (ec2-app-sg)" as SG
        node "Public IP / DNS" as ExtIP <<Network Endpoint>>
    }
     SG --> ExtIP : Allows Inbound TCP Port 8080 & 22
     ExtIP -- IGW : Route via IGW
     IGW -- Subnet : Connects VPC to Internet
  }


  package "Compute (EC2)" {
      node "EC2 Instance (app-instance)" as VM {
         interface "Elastic Network Interface (ENI)" as VMNic

         node "Operating System (e.g., Ubuntu)" as VMOS {

            package "Docker Engine (Daemon)" as DockerDaemon {
                node "Docker Volume\n(pg_ec2_data)" as DockerVol <<Persistent Storage>>
                node "Docker Network\n(e.g., bridge)" as DockerNet

                node "Running Container (Combined App)" as TheContainer {
                    interface "Container Network Interface" as ContainerNic
                    component "Spring Boot Process\n(Listens 0.0.0.0:8080)" as AppProc
                    component "PostgreSQL Process\n(Listens 127.0.0.1:5432)" as DBProc
                }
            }
         }
      }
  }
}

' --- Network Flow ---
User -down-> ExtIP : HTTP Request to\n<EC2_IP>:8080
ExtIP --> VMNic : Traffic reaches VM\n(Security Group Allows)
VMNic --> DockerDaemon : OS routes port 8080 traffic\nto Docker based on mapping

' --- Docker Internal ---
DockerDaemon -> TheContainer : Maps Host Port 8080\nto Container Port 8080
TheContainer -- ContainerNic : Attached to Docker Network
ContainerNic -- DockerNet : Logical Network

AppProc -> ContainerNic : Binds to 0.0.0.0:8080\n(Receives mapped traffic)
AppProc -> DBProc : Connects via loopback\n(localhost / 127.0.0.1:5432)

DBProc ..> DockerVol : Mounts & R/W Data\n(/var/lib/postgresql/data)

' --- Instance Association ---
VM -- Subnet : Instance Resides In
VMNic -- SG : Security Group Applied

@enduml