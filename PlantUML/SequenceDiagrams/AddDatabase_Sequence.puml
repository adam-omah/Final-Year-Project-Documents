@startuml
'https://plantuml.com/sequence-diagram

autonumber

participant User
participant DBSystem

User->>DBSystem: Select Database Type (NoSQL/SQL)
activate DBSystem

alt NoSQL
    User->>DBSystem: Choose NoSQL Database (MongoDB/CouchDB)
else SQL
    User->>DBSystem: Choose SQL Database (H2/SQLite)
end

User->>DBSystem: Enter Connection Details
DBSystem->>DBSystem: Validate Connection Details

alt Connection Valid
    DBSystem->>DBSystem: Add Database to System
    DBSystem->>User: Success Message
else
    DBSystem->>User: Error Message
end

deactivate DBSystem
@enduml