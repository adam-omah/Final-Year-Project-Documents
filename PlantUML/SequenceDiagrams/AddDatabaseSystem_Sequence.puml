@startuml

actor User
participant "System" as system
participant "Middleware" as middleware

User -> system : Open System Start Page
User -> system : Choose Add Database System
User -> system : Enter System Details (Name, Password, Configuration)
system -> system : Validate System Details
alt System Details Valid
    system -> middleware : Register Database System
    middleware -> system : Success Message
    system -> User : Success Message
else System Details Invalid
    system -> User : Error Message
end

@enduml
