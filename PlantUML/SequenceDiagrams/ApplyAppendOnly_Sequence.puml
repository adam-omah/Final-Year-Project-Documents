@startuml

actor User
participant "Database" as db
participant "Configuration Validator" as validator

User -> db : Select Database
User -> db : Choose Append-Only Strategy Implementation (Specific details if needed)
User -> db : Configure Append-Only Settings (e.g., Log Rotation Policy, Compression)
User -> validator : Validate Append-Only Configuration
alt Configuration Valid
    validator -> db : Enable Append-Only Mode for Database
    db -> User : Success Message
else Configuration Invalid
    validator -> User : Error Message
end

@enduml
