@startuml
start

:Select Source Database;
:Select Target Database;
:Choose Connection Type (Uni-Directional Replication, etc.);
:Fill Connection Details;

:Validate Connection Configuration;
if (Connection Valid) then (true)
  :Establish Connection;
  :Success Message;
else (false)
  :Error Message;
endif

if (Connection Type Valid) then (true)
  :Select Tables for Replication;
  :Choose Replication Strategy;
else (false)
  :Configure Type Details;
endif

stop
@enduml