@startuml

actor User
participant "Source Database" as sourceDB
participant "Target Database" as targetDB
participant "Replication Validator" as validator

User -> sourceDB : Select Source Database
User -> targetDB : Select Target Database
User -> validator : Choose Replication Type (Uni-directional, Bi-directional etc.)
User -> validator : Validate Replication Configuration
alt Configuration Valid
    User -> sourceDB : Select Tables/Data for Replication
    sourceDB -> targetDB : Initiate Replication
    targetDB -> User : Success Message
else Configuration Invalid
    validator -> User : Error Message
end

@enduml
