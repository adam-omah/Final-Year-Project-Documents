@startuml

actor User
participant "Replication Strategy" as replicationStrategy
participant "Sync Checker Configuration" as syncChecker
participant "Database" as db

User -> replicationStrategy : Select Replication Strategy to Check
replicationStrategy -> replicationStrategy : Retrieve details of Replication Strategy
replicationStrategy -> syncChecker : Display Sync Checker Configuration
User -> syncChecker : Select Time Interval for Analysis
syncChecker -> syncChecker : Validate Sync Check configuration
alt Valid Sync Check
    syncChecker -> syncChecker : Create Sync Checker
else Invalid Sync Check
    syncChecker -> User : Display Error message
end
syncChecker -> db : Compare Source and Target Database Data
alt Data Discrepancies Found
    db -> syncChecker : Identify Discrepancy Details (Tables, Rows, Data Values)
    syncChecker -> syncChecker : Generate Discrepancy Report
    syncChecker -> User : Notify Administrators
else No Data Discrepancies
    db -> syncChecker : Generate Sync Success Report
end

@enduml
