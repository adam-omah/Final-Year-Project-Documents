@startuml

actor User
participant "Database Selector" as dbSelector
participant "System" as system

User -> dbSelector : Select Database Type (NoSQL/SQL)
alt NoSQL
    dbSelector -> dbSelector : Choose NoSQL Database (MongoDB/CouchDB)
else SQL
    dbSelector -> dbSelector : Choose SQL Database (H2/SQLite)
end

User -> dbSelector : Enter Connection Details (ConnectionString, Password, Configuration)
dbSelector -> system : Validate Connection Details
alt Connection Valid
    system -> system : Add Database to System
    system -> User : Success Message
else Connection Invalid
    system -> User : Error Message
end

@enduml
